# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real secrets.

# LLM Provider Configuration:
# Choose from: none, gemini, openrouter, ollama, openai_compat, anthropic
DOCUMIND_LLM_PROVIDER=none

# For Google Gemini (Google AI Studio - AQ... key):
# DOCUMIND_LLM_PROVIDER=gemini
# GEMINI_API_KEY=AQ...
# DOCUMIND_MODEL=gemini-3.5-flash

# For OpenRouter (Access 100+ models via one API):
# DOCUMIND_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# DOCUMIND_MODEL=meta-llama/llama-3.1-8b-instruct

# For Anthropic:
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# DOCUMIND_MODEL=claude-haiku-4-5-20251001

# For Ollama (Free / Local):
# DOCUMIND_LLM_PROVIDER=ollama
# DOCUMIND_OPENAI_BASE_URL=http://localhost:11434/v1
# DOCUMIND_MODEL=llama3

# For OpenAI-compatible endpoints (Groq, Gemini OpenAI-compat, OpenAI):
# DOCUMIND_LLM_PROVIDER=openai_compat
# DOCUMIND_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# DOCUMIND_OPENAI_API_KEY=gsk_...
# DOCUMIND_MODEL=llama-3.1-8b-instant

# Optional configuration overrides:
# DOCUMIND_HOME=~/.documind
# DOCUMIND_EMBED_MODEL=BAAI/bge-small-en-v1.5
# DOCUMIND_CHUNK_SIZE=200
# DOCUMIND_OVERLAP=30
# DOCUMIND_TOP_K=5
# DOCUMIND_MIN_SCORE=0.35
# DOCUMIND_MAX_TOKENS=600
# DOCUMIND_LLM_TIMEOUT_S=20.0
# DOCUMIND_LLM_RETRIES=1
# DOCUMIND_LOG_QUESTIONS=0

# Phase 5 REST API and Security overrides:
# DOCUMIND_API_KEY=your-32-char-random-api-key-here
# DOCUMIND_ENV=dev
# DOCUMIND_RATE_LIMIT_PER_MIN=20
# DOCUMIND_MAX_UPLOAD_MB=50
# DOCUMIND_MAX_PAGES=500
# DOCUMIND_ALLOW_DEBUG=0

# Phase 1 Public Demo Gateway & Session Isolation:
# DOCUMIND_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# DOCUMIND_SESSION_TTL_S=86400
# DOCUMIND_DEMO_RATE_LIMIT_PER_MIN=30

# Authentication & User Database (Production & Dev):
# DOCUMIND_REQUIRE_AUTH=1
# DOCUMIND_ALLOW_GUEST_UPLOAD=0
# DOCUMIND_DATABASE_URL=sqlite:///~/.documind/auth.db
# (For PostgreSQL: DOCUMIND_DATABASE_URL=postgresql://user:password@localhost:5432/documind)
# DOCUMIND_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# DOCUMIND_GOOGLE_CLIENT_SECRET=your-client-secret
# DOCUMIND_GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# DOCUMIND_SESSION_SECRET=your-secure-random-session-secret-key-at-least-32-chars
# DOCUMIND_ALLOWED_HOSTS=your-service.onrender.com

# SaaS Tier & Razorpay Monetization (Optional):
# DOCUMIND_FREE_DOC_LIMIT=1
# DOCUMIND_FREE_QUESTION_LIMIT=5
# RAZORPAY_KEY_ID=rzp_live_your_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_secret_key
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

